# Normalize source and configuration files while preserving Windows project files.
* text=auto
*.cs       text eol=crlf
*.resx     text eol=crlf
*.sln      text eol=crlf
*.csproj   text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.config   text eol=crlf
*.xml      text eol=crlf
*.json     text eol=lf
*.md       text eol=lf
*.txt      text eol=crlf
*.csv      text eol=crlf
*.ps1      text eol=crlf
*.py       text eol=lf

# Executables, libraries, symbols, and compiled resources.
*.exe       filter=lfs diff=lfs merge=lfs -text
*.dll       filter=lfs diff=lfs merge=lfs -text
*.lib       filter=lfs diff=lfs merge=lfs -text
*.obj       filter=lfs diff=lfs merge=lfs -text
*.pdb       filter=lfs diff=lfs merge=lfs -text
