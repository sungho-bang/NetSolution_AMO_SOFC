<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- 두 설비는 동일한 PLC 디바이스 맵을 각 IP에서 독립적으로 사용합니다. -->
    <add key="Plc.AutoConnect" value="true" />
    <add key="Plc.Port" value="10000" />
    <add key="Plc.PollIntervalMs" value="50" />
    <add key="Plc.ReconnectDelayMs" value="2000" />
    <add key="Plc.TimeoutMs" value="3000" />
    <add key="Plc.LoadScale" value="1000" />
    <!-- 0은 한 검사 Cycle의 모든 읽기 값을 표시합니다. 양수 지정 시 최근 N개만 화면에 표시합니다. -->
    <add key="Plc.MaxGraphPoints" value="0" />
    <!-- PLC에서 M1003/D1002를 운용할 때 true로 변경하면 유효 데이터/중복 샘플 검사를 적용합니다. -->
    <add key="Plc.UseDataValid" value="false" />
    <add key="Plc.UseSampleSequence" value="false" />
    <add key="Plc.StartRequestDevice" value="M1001" />
    <add key="Plc.EndRequestDevice" value="M1002" />
    <add key="Plc.DataValidDevice" value="M1003" />
    <add key="Plc.LoadRawDevice" value="D1000" />
    <add key="Plc.SampleSequenceDevice" value="D1002" />
    <add key="Plc.StartAckDevice" value="M1101" />
    <add key="Plc.EndAckDevice" value="M1102" />
    <add key="Station1.IpAddress" value="172.20.9.100" />
    <add key="Station2.IpAddress" value="172.20.9.101" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Resources.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.10" newVersion="9.0.0.10" />
      </dependentAssembly>
    </assemblyBinding>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>