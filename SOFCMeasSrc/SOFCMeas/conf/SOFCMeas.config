<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- 두 설비는 동일한 PLC 디바이스 맵을 각 IP에서 독립적으로 사용합니다. -->
    <add key="Plc.AutoConnect" value="true" />
    <add key="Plc.Port" value="5000" />
    <!-- D700~D704 ASCII 하중 프레임 읽기 주기: 1초 -->
    <add key="Plc.PollIntervalMs" value="1000" />
    <!-- END_REQ 수신 후에도 2초 동안 D700~D704 하중을 계속 수집합니다. -->
    <add key="Plc.PostStopReadMs" value="2000" />
    <add key="Plc.ReconnectDelayMs" value="2000" />
    <add key="Plc.TimeoutMs" value="3000" />
    <!-- 내부·시뮬레이션 원시값 배율: 원시값 = 하중(kgf) x LoadScale. ASCII 하중값에는 나누지 않습니다. -->
    <add key="Plc.LoadScale" value="1000" />
    <!-- 0은 한 검사 Cycle의 모든 읽기 값을 표시합니다. 양수 지정 시 최근 N개만 화면에 표시합니다. -->
    <add key="Plc.MaxGraphPoints" value="0" />
    <!-- PLC -> PC: D810 WORD 값 1=START_REQ, 0=END_REQ -->
    <add key="Plc.RequestDevice" value="D810" />
    <add key="Plc.StartRequestValue" value="1" />
    <add key="Plc.EndRequestValue" value="0" />
    <!-- PLC -> PC: D700부터 5 WORD(D700~D704)를 하위/상위 바이트 순서로 ASCII 연결합니다. -->
    <!-- 필수 문법: STX(0x02) + 헤더 '1' + 부호('+' 또는 '-') + 6바이트 숫자 영역(앞 공백 허용) + ETX(0x03). 부호를 포함해 kgf로 해석합니다. -->
    <!-- 예: 12546, 8235, 11824, 12596, 816 -> STX + "1+ 0.410" + ETX -> +0.410 kgf -->
    <!-- 문법 오류 프레임은 샘플에서 제외하고 알람 로그를 기록하며 다음 읽기를 계속합니다. -->
    <add key="Plc.LoadRawDevice" value="D700" />
    <add key="Station1.IpAddress" value="172.20.9.100" />
    <add key="Station2.IpAddress" value="172.20.9.101" />
    <!-- 로그는 C:\SOFCMeas\log\yyyy\MM\dd에 저장되며 파일당 지정 크기로 분할됩니다. -->
    <add key="Log.RetentionDays" value="30" />
    <add key="Log.AutoDelete" value="true" />
    <add key="Log.MaximumFileSizeMb" value="20" />
    <!-- LOT 종료 시 메모리의 모든 검사/원시 하중 데이터가 C:\SOFCMeas\Data\yyyy\MM\dd에 저장됩니다. -->
    <add key="Runtime.Simulation" value="0" />
  </appSettings>
</configuration>
